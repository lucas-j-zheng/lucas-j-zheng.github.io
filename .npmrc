# Supply-chain defenses, enforced repo-locally so they hold on any machine.

# pnpm >= 10 already blocks dependency lifecycle scripts by default;
# this also covers any stray npm invocation.
ignore-scripts=true

# Refuse package versions published within the last 14 days (pnpm, minutes).
# Frozen-lockfile installs are unaffected. Do not lower or bypass this;
# prefer pinning an older version, or a narrow per-package exemption.
minimum-release-age=20160
